public function obtenerTodos()
<?php

require_once "app/config/database.php";

class Producto
{
    private $conexion;

    public function __construct()
    {
        $db = new Database();
        $this->conexion = $db->conectar();
    }


    // ==========================================
    // LISTAR PRODUCTOS
    // ==========================================

    public function obtenerTodos()
    {
        $sql = "SELECT
                    p.id_producto,
                    p.id_empresa,
                    p.id_categoria_producto,
                    p.codigo_producto,
                    p.nombre_producto,
                    p.descripcion_producto,
                    p.categoria_producto,
                    p.marca_producto,
                    p.unidad_medida_producto,
                    p.stock_producto,
                    p.stock_minimo_producto,
                    p.precio_compra_producto,
                    p.precio_venta_producto,
                    p.imagen_producto,
                    p.estado_producto,
                    p.fecha_creacion_producto,
                    p.fecha_actualizacion_producto,
                    e.razon_social_empresa
                FROM productos p
                INNER JOIN empresas e
                    ON p.id_empresa = e.id_empresa
                ORDER BY p.id_producto ASC";

        $stmt = $this->conexion->prepare($sql);

        $stmt->execute();

        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }


    // ==========================================
    // OBTENER PRODUCTO POR ID
    // ==========================================

    public function obtenerPorId($id)
    {
        $sql = "SELECT *
                FROM productos
                WHERE id_producto = :id";

        $stmt = $this->conexion->prepare($sql);

        $stmt->execute([
            ":id" => $id
        ]);

        return $stmt->fetch(PDO::FETCH_ASSOC);
    }


    // ==========================================
    // VERIFICAR CÓDIGO DEL PRODUCTO
    // ==========================================

    public function existeCodigo($codigo)
    {
        $sql = "SELECT COUNT(*)
                FROM productos
                WHERE codigo_producto = :codigo";

        $stmt = $this->conexion->prepare($sql);

        $stmt->execute([
            ":codigo" => $codigo
        ]);

        return $stmt->fetchColumn() > 0;
    }


    // ==========================================
    // CREAR PRODUCTO
    // ==========================================

    public function crear(
        $idEmpresa,
        $idCategoria,
        $codigo,
        $nombre,
        $descripcion,
        $categoria,
        $marca,
        $unidadMedida,
        $stock,
        $stockMinimo,
        $precioCompra,
        $precioVenta,
        $imagen,
        $estado
    ) {

        $sql = "INSERT INTO productos
                (
                    id_empresa,
                    id_categoria_producto,
                    codigo_producto,
                    nombre_producto,
                    descripcion_producto,
                    categoria_producto,
                    marca_producto,
                    unidad_medida_producto,
                    stock_producto,
                    stock_minimo_producto,
                    precio_compra_producto,
                    precio_venta_producto,
                    imagen_producto,
                    estado_producto
                )
                VALUES
                (
                    :id_empresa,
                    :id_categoria,
                    :codigo,
                    :nombre,
                    :descripcion,
                    :categoria,
                    :marca,
                    :unidad_medida,
                    :stock,
                    :stock_minimo,
                    :precio_compra,
                    :precio_venta,
                    :imagen,
                    :estado
                )";

        $stmt = $this->conexion->prepare($sql);

        return $stmt->execute([
            ":id_empresa" => $idEmpresa,
            ":id_categoria" => $idCategoria,
            ":codigo" => $codigo,
            ":nombre" => $nombre,
            ":descripcion" => $descripcion,
            ":categoria" => $categoria,
            ":marca" => $marca,
            ":unidad_medida" => $unidadMedida,
            ":stock" => $stock,
            ":stock_minimo" => $stockMinimo,
            ":precio_compra" => $precioCompra,
            ":precio_venta" => $precioVenta,
            ":imagen" => $imagen,
            ":estado" => $estado
        ]);
    }


    // ==========================================
    // ACTUALIZAR PRODUCTO
    // ==========================================

    public function actualizar(
    $idProducto,
    $idEmpresa,
    $idCategoria,
    $codigo,
    $nombre,
    $descripcion,
    $categoria,
    $marca,
    $unidadMedida,
    $stock,
    $stockMinimo,
    $precioCompra,
    $precioVenta,
    $imagen,
    $estado
) {

    // ==================================================
    // SI NO HAY NUEVA IMAGEN, CONSERVAR LA ACTUAL
    // ==================================================

    if ($imagen === null || $imagen === "") {

        $sql = "UPDATE productos
                SET
                    id_empresa = :id_empresa,
                    id_categoria_producto = :id_categoria,
                    codigo_producto = :codigo,
                    nombre_producto = :nombre,
                    descripcion_producto = :descripcion,
                    categoria_producto = :categoria,
                    marca_producto = :marca,
                    unidad_medida_producto = :unidad_medida,
                    stock_producto = :stock,
                    stock_minimo_producto = :stock_minimo,
                    precio_compra_producto = :precio_compra,
                    precio_venta_producto = :precio_venta,
                    estado_producto = :estado,
                    fecha_actualizacion_producto = NOW()
                WHERE id_producto = :id_producto";

        $stmt = $this->conexion->prepare($sql);

        return $stmt->execute([
            ":id_producto" => $idProducto,
            ":id_empresa" => $idEmpresa,
            ":id_categoria" => $idCategoria,
            ":codigo" => $codigo,
            ":nombre" => $nombre,
            ":descripcion" => $descripcion,
            ":categoria" => $categoria,
            ":marca" => $marca,
            ":unidad_medida" => $unidadMedida,
            ":stock" => $stock,
            ":stock_minimo" => $stockMinimo,
            ":precio_compra" => $precioCompra,
            ":precio_venta" => $precioVenta,
            ":estado" => $estado
        ]);
    }

    // ==================================================
    // ACTUALIZAR INCLUYENDO NUEVA IMAGEN
    // ==================================================

    $sql = "UPDATE productos
            SET
                id_empresa = :id_empresa,
                id_categoria_producto = :id_categoria,
                codigo_producto = :codigo,
                nombre_producto = :nombre,
                descripcion_producto = :descripcion,
                categoria_producto = :categoria,
                marca_producto = :marca,
                unidad_medida_producto = :unidad_medida,
                stock_producto = :stock,
                stock_minimo_producto = :stock_minimo,
                precio_compra_producto = :precio_compra,
                precio_venta_producto = :precio_venta,
                imagen_producto = :imagen,
                estado_producto = :estado,
                fecha_actualizacion_producto = NOW()
            WHERE id_producto = :id_producto";

    $stmt = $this->conexion->prepare($sql);

    return $stmt->execute([
        ":id_producto" => $idProducto,
        ":id_empresa" => $idEmpresa,
        ":id_categoria" => $idCategoria,
        ":codigo" => $codigo,
        ":nombre" => $nombre,
        ":descripcion" => $descripcion,
        ":categoria" => $categoria,
        ":marca" => $marca,
        ":unidad_medida" => $unidadMedida,
        ":stock" => $stock,
        ":stock_minimo" => $stockMinimo,
        ":precio_compra" => $precioCompra,
        ":precio_venta" => $precioVenta,
        ":imagen" => $imagen,
        ":estado" => $estado
    ]);
}
    // ==========================================
    // ELIMINAR PRODUCTO
    // ==========================================

    public function eliminar($idProducto)
    {
        $sql = "DELETE FROM productos
                WHERE id_producto = :id_producto";

        $stmt = $this->conexion->prepare($sql);

        return $stmt->execute([
            ":id_producto" => $idProducto
        ]);
    }
}
